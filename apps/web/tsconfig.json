{
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/features/*": ["./apps/web/features/*"],
      "@/lib/*": ["./apps/web/lib/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules"],
  "extends": "@shared/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
