{
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/features/*": ["./features/*"],
      "@fixtures/*": ["../../tools/__fixtures__/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules"],
  "extends": "@shared/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/ui/src/display/media/work-media.tsx",
    "../../packages/ui/src/layout/hero/hero-surface.tsx",
    "../../packages/ui/src/sections/careers-section/career-editors.tsx",
    "../../packages/ui/src/sections/skills-section/skills-editor.tsx",
    "../../packages/ui/src/sections/hero-section/HeroSettingsEditor.tsx"
  ]
}
