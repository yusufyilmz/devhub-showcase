{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/env": ["./env.ts"],
      "@/features/*": ["./features/*"],
      "@/lib/*": ["./lib/*"],
      "@fixtures/*": ["../../tools/test/fixtures/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "extends": "@shared/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
