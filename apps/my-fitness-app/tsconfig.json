{
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/services/db/*": ["../../packages/services/src/fitness/db/*"],
      "@shared/services/fitness": ["../../packages/services/src/fitness/index.ts"],
      "@shared/services/fitness/meal": ["../../packages/services/src/meal/index.ts"],
      "@shared/services/fitness/schedule": ["../../packages/services/src/schedule/index.ts"],
      "@shared/services/fitness/task": ["../../packages/services/src/fitness/task/index.ts"],
      "@shared/services/fitness/types": ["../../packages/services/src/types/index.ts"],
      "@shared/services/fitness/workspace": ["../../packages/services/src/workspace/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "extends": "@shared/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
