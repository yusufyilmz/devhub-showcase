NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
APP_URL="http://localhost:3002"
# Same Supabase project as MyDevStudio. The auth cookie is shared on this host.
# Add http://localhost:3002/auth/callback to that project's redirect URLs.
# Server-only pooler URI from the Connect panel.
SUPABASE_DB_URL="postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres"

# Authentication > Users id from that same project. This account alone can edit.
WORKSPACE_OWNER_ID="00000000-0000-4000-8000-000000000001"
