NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
APP_URL="http://localhost:3002"
# Optional second exact origin for a public alias. Set only on the matching deployment.
FITNESS_ADDITIONAL_ORIGIN=""
# Use the existing Fitness Supabase project for both Auth and the database.
# Add http://localhost:3002/auth/callback to that project's redirect URLs.
# Server-only pooler URI from the Connect panel.
SUPABASE_DB_URL="postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres"

# Optional background notifications. Never prefix the private key or cron secret
# with NEXT_PUBLIC_. GET /api/notifications returns only the public VAPID key.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:YOUR_NOTIFICATION_CONTACT@example.com"
CRON_SECRET=""

# Optional private Plan assistant. Server-only provider and attempt-limit settings.
OPENAI_API_KEY=""
REDIS_URL=""
REDIS_TOKEN=""
OPENAI_FITNESS_MODEL=""
OPENAI_FITNESS_AGENT_ID=""
OPENAI_NOTIFICATIONS_MODEL=""
OPENAI_NOTIFICATIONS_AGENT_ID=""

# Additional validated application settings (optional unless a feature needs them).
NODE_ENV=development
APPLICATION_NAME=my-fitness-app
LOG_LEVEL=
CHAT_V2_DEBUG=false
OPENAI_FITNESS_INSTRUCTIONS=
OPENAI_NOTIFICATIONS_INSTRUCTIONS=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LOG_LEVEL=
NEXT_PUBLIC_LOG_PREFIX=
NEXT_PUBLIC_CHAT_V2_DEBUG=false
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_PROJECT_URL=http://localhost:3002
NEXT_PUBLIC_ENABLE_LOGGING=false
NEXT_PUBLIC_LOG_STRING_OUTPUT=
