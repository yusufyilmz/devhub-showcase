# The public portfolio builds and runs without credentials.
APPLICATION_NAME=devhub-showcase
LOG_LEVEL=info
# Optional: Supabase referrals/reviews (use a publishable key or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: AI chat. Both Redis variables are required for its rate limit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
REDIS_URL=
REDIS_TOKEN=

# Canonical platform origin for portfolios, sitemap and sharing images.
NEXT_PUBLIC_SITE_URL=https://mydevstudio.vercel.app

# Optional CV upload extraction. Uses OPENAI_API_KEY and Redis above.
OPENAI_CV_MODEL=gpt-6-luna
# Global rolling 24 hour import cap, in addition to 3 attempts/user/hour.
CV_IMPORT_DAILY_LIMIT=100

# Public portfolio assistant; independent of CV import configuration.
OPENAI_CHAT_MODEL=gpt-6-luna
