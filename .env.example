# The public portfolio builds and runs without credentials.
APPLICATION_NAME=devhub-showcase
LOG_LEVEL=info
# Optional: Supabase referrals/reviews (use a publishable key or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: AI chat. Both Redis variables are required for its rate limit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REDIS_URL=
REDIS_TOKEN=
# Legacy Prisma tooling only. Never use production credentials in PR checks.
DATABASE_URL=

# Legacy adapter selector (the public portfolio uses versioned content).
ORM_TYPE=supabase
