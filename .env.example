# The public portfolio builds and runs without credentials.
APPLICATION_NAME=devhub-showcase
LOG_LEVEL=info
# Optional: Supabase referrals/reviews (use a publishable key or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: AI chat. Both Redis variables are required for its rate limit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
REDIS_URL=
REDIS_TOKEN=

# Canonical platform origin for portfolios, sitemap and sharing images.
NEXT_PUBLIC_SITE_URL=https://mydevstudio.vercel.app

# Optional CV upload extraction. Uses OPENAI_API_KEY and Redis above.
OPENAI_CV_MODEL=gpt-6-luna
# Global rolling 24 hour import cap, in addition to 3 attempts/user/hour.
CV_IMPORT_DAILY_LIMIT=100

# Public portfolio assistant; independent of CV import configuration.
OPENAI_CHAT_MODEL=gpt-6-luna

# Optional Stripe sandbox billing. Live keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_CHAT_LIMIT=
STRIPE_PRO_EDITOR_LIMIT=
# Trusted server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional private owner editing assistant. Uses existing OpenAI, Redis and billing configuration.
OPENAI_EDITOR_MODEL=gpt-6-luna

# Optional Google People profile import: public OAuth client ID, not a client secret.
# Enable People API and register app origins/scopes in the same Google Cloud project.
GOOGLE_PROFILE_CLIENT_ID=

# Optional server-only failure collector. No request or user content is sent.
# HTTPS endpoint accepting JSON; verify X-Monitoring-Signature (HMAC-SHA256 of raw body).
# Configure separately for each deployment; leave empty to use structured server logs only.
MONITORING_WEBHOOK_URL=
# Random secret of at least 32 characters. Never expose in NEXT_PUBLIC_ variables.
MONITORING_WEBHOOK_SECRET=
