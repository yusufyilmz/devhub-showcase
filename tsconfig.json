{
  "compilerOptions": {
    "paths": {
      "@/features/*": ["./apps/web/features/*"],
      "@/lib/*": ["./apps/web/lib/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "extends": "./packages/typescript-config/base.json",
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.mts",
    "turbo/**/*.ts",
    "generators/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
