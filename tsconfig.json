{
  "compilerOptions": {
    "paths": {
      "@/app/*": ["./apps/my-dev-studio/app/*"],
      "@/features/*": ["./apps/my-dev-studio/features/*"],
      "@fixtures/*": ["./tools/__fixtures__/*"],
      "@shared/assistant": ["./packages/assistant/src/index.ts"],
      "@shared/assistant/*": ["./packages/assistant/src/*"],
      "@shared/auth": ["./packages/auth/src/index.ts"],
      "@shared/auth/*": ["./packages/auth/src/*"],
      "@shared/components": ["./packages/components/src/index.ts"],
      "@shared/components/*": ["./packages/components/src/*"],
      "@shared/components/chat": ["./packages/components/src/chat/index.ts"],
      "@shared/components/editor": ["./packages/components/src/editor/index.ts"],
      "@shared/components/forms": ["./packages/components/src/forms/index.ts"],
      "@shared/components/login": ["./packages/components/src/auth/login-panel.tsx"],
      "@shared/components/portfolio": ["./packages/components/src/portfolio/index.ts"],
      "@shared/components/section/editors": ["./packages/components/src/sections/editors/index.ts"],
      "@shared/components/section/renderers": [
        "./packages/components/src/sections/renderers/index.ts"
      ],
      "@shared/components/sections": ["./packages/components/src/sections/variants/index.ts"],
      "@shared/config": ["./packages/config/src/index.ts"],
      "@shared/content": ["./packages/content/src/index.ts"],
      "@shared/lib/*": ["./packages/lib/src/*"],
      "@shared/lib/portfolio": ["./packages/lib/src/services/portfolio/index.ts"],
      "@shared/lib/profile-service": ["./packages/lib/src/services/profile-service.ts"],
      "@shared/lib/published-profile": ["./packages/lib/src/services/published-profile.ts"],
      "@shared/lib/stripe": ["./packages/lib/src/billing/stripe.ts"],
      "@shared/lib/types": ["./packages/lib/src/types/index.ts"],
      "@shared/lib/user-profile": ["./packages/lib/src/services/user-profile.ts"],
      "@shared/lib/utils": ["./packages/lib/src/utils/index.ts"],
      "@shared/ui/*": ["./packages/ui/src/components/*"],
      "@shared/ui/components": ["./packages/ui/src/components/index.ts"],
      "@shared/ui/stores": ["./packages/ui/src/stores/index.ts"],
      "@shared/ui/theme": ["./packages/ui/src/theme/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "extends": "./tools/typescript-config/base.json",
  "include": [
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "tests/support/**/*.ts",
    "vitest.config.mts",
    "turbo/**/*.ts",
    "generators/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
