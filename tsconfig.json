{
  "compilerOptions": {
    "paths": {
      "@/app/*": ["./apps/my-dev-studio/app/*"],
      "@/features/*": ["./apps/my-dev-studio/features/*"],
      "@fixtures/*": ["./tools/test/fixtures/*"],
      "@shared/assistant": ["./packages/assistant/src/index.ts"],
      "@shared/assistant/*": ["./packages/assistant/src/*"],
      "@shared/assistant/studio": ["./packages/assistant/src/studio/index.ts"],
      "@shared/auth": ["./packages/auth/src/index.ts"],
      "@shared/auth/*": ["./packages/auth/src/*"],
      "@shared/billing": ["./packages/billing/src/index.ts"],
      "@shared/billing-repository": ["./packages/billing/src/server/repository.ts"],
      "@shared/billing/*": ["./packages/billing/src/*"],
      "@shared/billing/server": ["./packages/billing/src/server/index.ts"],
      "@shared/config": ["./packages/config/src/index.ts"],
      "@shared/lib/*": ["./packages/lib/src/*"],
      "@shared/lib/types": ["./packages/lib/src/types/index.ts"],
      "@shared/lib/utils": ["./packages/lib/src/utils/index.ts"],
      "@shared/notifications": ["./packages/notifications/src/index.ts"],
      "@shared/notifications/*": ["./packages/notifications/src/*"],
      "@shared/services": ["./packages/services/src/index.ts"],
      "@shared/services/*": ["./packages/services/src/*"],
      "@shared/templates/studio": ["./packages/templates/src/studio/index.ts"],
      "@shared/ui": ["./packages/ui/src/components/index.ts"],
      "@shared/ui/*": [
        "./packages/ui/src/buttons/*",
        "./packages/ui/src/forms/*",
        "./packages/ui/src/feedback/*",
        "./packages/ui/src/overlays/*",
        "./packages/ui/src/layout/*",
        "./packages/ui/src/navigation/*",
        "./packages/ui/src/display/*",
        "./packages/ui/src/customizers/*",
        "./packages/ui/src/cards/*",
        "./packages/ui/src/editors/*",
        "./packages/ui/src/page/*",
        "./packages/ui/src/sections/*"
      ],
      "@shared/ui/cards": ["./packages/ui/src/cards/index.ts"],
      "@shared/ui/careers-section": ["./packages/ui/src/sections/careers-section/index.tsx"],
      "@shared/ui/chat": ["./packages/assistant/src/chat/index.ts"],
      "@shared/ui/components": ["./packages/ui/src/components/index.ts"],
      "@shared/ui/display": ["./packages/ui/src/display/index.ts"],
      "@shared/ui/editor": ["./packages/ui/src/editors/index.ts"],
      "@shared/ui/forms": ["./packages/ui/src/forms/index.ts"],
      "@shared/ui/google-import": ["./packages/ui/src/google-import/index.ts"],
      "@shared/ui/layout": ["./packages/ui/src/layout/index.ts"],
      "@shared/ui/login": ["./packages/ui/src/forms/site-login/login-panel.tsx"],
      "@shared/ui/navigation": ["./packages/ui/src/navigation/index.ts"],
      "@shared/ui/overlays": ["./packages/ui/src/overlays/index.ts"],
      "@shared/ui/page": ["./packages/ui/src/page/index.ts"],
      "@shared/ui/portfolio": ["./packages/ui/src/portfolio/index.ts"],
      "@shared/ui/providers": ["./packages/ui/src/providers/index.ts"],
      "@shared/ui/section": ["./packages/ui/src/layout/section/index.ts"],
      "@shared/ui/section/editors": ["./packages/ui/src/sections/editors/index.ts"],
      "@shared/ui/section/renderers": ["./packages/ui/src/sections/renderers/index.ts"],
      "@shared/ui/sections": ["./packages/ui/src/sections/index.ts"],
      "@shared/ui/sections/studio": ["./packages/ui/src/sections/studio/index.ts"],
      "@shared/ui/stores": ["./packages/ui/src/stores/index.ts"],
      "@shared/ui/theme": ["./packages/ui/src/theme/index.ts"],
      "@shared/ui/theme/studio": ["./packages/ui/src/theme/studio/index.ts"],
      "@shared/ui/utils": ["./packages/ui/src/utils/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["apps/my-fitness-app"],
  "extends": "./tools/typescript-config/base.json",
  "include": [
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "tools/test/support/**/*.ts",
    "vitest.config.mts",
    "turbo/**/*.ts",
    "generators/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
