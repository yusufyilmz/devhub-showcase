{
  "name": "devhub-showcase",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "assist": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "build": "turbo run build",
    "check": "pnpm check:lint && pnpm check:complexity && pnpm check:docs && pnpm check:skills && pnpm check:types",
    "check:assist": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check:ci": "biome ci --error-on-warnings .",
    "check:complexity": "pnpm exec biome check --only=complexity --error-on-warnings",
    "check:docs": "biome format **/*.md && markdownlint-cli2 **/*.md",
    "check:format": "biome format .",
    "check:lint": "biome check .",
    "check:skills": "node tools/scripts/check-skills.mjs",
    "check:types": "pnpm run typecheck",
    "clean": "turbo run clean",
    "create-component": "turbo gen create-component",
    "create-package": "turbo gen create-package",
    "cv:generate": "turbo gen cv",
    "dev": "turbo run dev",
    "fix:docs": "biome format --write **/*.md && markdownlint-cli2 --fix **/*.md",
    "fix:skills": "node tools/scripts/check-skills.mjs --fix",
    "format": "biome format --write .",
    "format:docs": "biome format --write **/*.md",
    "lint": "biome lint .",
    "lint:check": "biome check --write .",
    "lint:check:fix": "biome check --write .",
    "lint:fix": "biome lint --write .",
    "lint:fix:errors": "biome check --diagnostic-level=error --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "prepare": "husky",
    "start": "pnpm --filter web start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && turbo run typecheck"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@shared/cv": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  }
}
