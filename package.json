{
  "name": "devhub-showcase",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter web start",
    "clean": "turbo run clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "assist": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "assist:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "types:check": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create-package": "turbo gen create-package",
    "create-component": "turbo gen create-component",
    "cv:generate": "turbo gen cv",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@shared/cv": "workspace:*",
    "@playwright/test": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  }
}
