{
  "name": "devhub-showcase",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "assist": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "build": "turbo run build",
    "postbuild": "pnpm generate:catalogs",
    "build:fitness": "turbo run build --filter=my-fitness-app",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:studio": "turbo run build --filter=my-dev-studio",
    "build:tools": "turbo run build --filter='./tools/*'",
    "check": "pnpm check:links --no-external && pnpm check:catalogs && pnpm check:exports && pnpm check:lint && pnpm check:complexity && pnpm check:docs && pnpm check:skills && pnpm check:exports && pnpm check:types",
    "check:all": "node tools/cli/checks/all.ts",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err apps packages tools",
    "check:assist": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check:build": "turbo run build",
    "check:catalogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-catalogs.mjs --check",
    "check:ci": "biome ci --error-on-warnings .",
    "check:circular": "knip --cycles --reporter cycles",
    "check:complexity": "pnpm exec biome check --only=complexity/noExcessiveCognitiveComplexity --error-on-warnings",
    "check:coverage": "vitest run --project unit --project pglite --coverage",
    "check:depcheck": "depcheck . --config .depcheckrc",
    "check:depcheck:workspaces": "node tools/cli/checks/depcheck-workspaces.ts",
    "check:docs": "biome format **/*.md && markdownlint-cli2 **/*.md",
    "check:duplicates": "jscpd",
    "check:exports": "node tools/cli/scripts/check-exports.mjs",
    "check:fix": "biome check --write .",
    "check:format": "biome format .",
    "check:links": "node tools/cli/links/cli.ts",
    "check:lint": "biome check .",
    "check:outdated": "pnpm outdated -r",
    "check:packages": "pnpm -r --filter './packages/*' --if-present run lint",
    "check:secrets": "gitleaks git --redact .",
    "check:security": "pnpm audit --audit-level high",
    "check:security:prod": "pnpm audit --prod --audit-level high",
    "check:skills": "node tools/cli/skills/cli.ts validate && pnpm test:agent-authoring",
    "check:types": "pnpm run typecheck",
    "check:ui-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-ui-catalog.mjs --check",
    "check:unit": "vitest run --project unit --project pglite",
    "check:unused:all": "pnpm check:unused:files && pnpm check:unused:deps && pnpm check:unused:code && pnpm check:duplicates && pnpm check:depcheck",
    "check:unused:code": "knip --exports --include-entry-exports",
    "check:unused:deps": "knip --dependencies",
    "check:unused:files": "knip --files",
    "check:unused:namespaces": "knip --include nsExports,nsTypes",
    "clean": "turbo run clean",
    "cli:check": "node tools/cli/checks/cli.ts",
    "cli:lookup": "node tools/cli/lookup/cli.ts",
    "cli:skills": "node tools/cli/skills/cli.ts",
    "cli:storybook": "node tools/cli/storybook/cli.ts",
    "create-component": "turbo gen create-component --config tools/cli/generators/config.ts",
    "create-package": "turbo gen create-package --config tools/cli/generators/config.ts",
    "cv:generate": "turbo gen cv --config tools/cli/generators/config.ts",
    "dev": "turbo run dev",
    "dev:setup": "node tools/cli/scripts/setup-development.mjs",
    "fix:docs": "pnpm exec markdownlint-cli2 --fix **/*.md && biome format --write **/*.md",
    "fix:skills": "node tools/cli/skills/cli.ts validate --fix",
    "format": "biome format --write .",
    "format:docs": "biome format --write **/*.md",
    "generate:catalogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-catalogs.mjs",
    "generate:ui-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-ui-catalog.mjs",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:all": "biome check --reporter=concise .",
    "lint:fix": "biome lint --write .",
    "lint:fix:errors": "biome check --diagnostic-level=error --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "lint:organize-imports": "biome check --write --reporter=concise --only=assist/source/organizeImports .",
    "lint:packages": "pnpm -r --filter './packages/*' --if-present run lint",
    "lint:staged": "pnpm exec lint-staged --no-stash",
    "lookup": "node tools/cli/lookup/cli.ts",
    "precommit": "pnpm run lint:staged && pnpm check:secrets",
    "prepare": "husky",
    "setup": "node tools/cli/scripts/setup-repository.mjs",
    "setup:e2e": "pnpm exec playwright install chromium",
    "setup:env": "node tools/cli/scripts/setup-development.mjs",
    "setup:supabase": "sh -c 'pnpm supabase:connect \"$@\" && (supabase status >/dev/null 2>&1 || supabase start || (supabase stop && supabase start)) && pnpm run:migration' --",
    "start": "pnpm --filter web start",
    "storybook": "pnpm --filter storybook-app storybook",
    "storybook:build": "pnpm --filter storybook-app build-storybook",
    "storybook:start": "pnpm --filter storybook-app start",
    "supabase:connect": "supabase link",
    "supabase:migrate": "supabase migration up",
    "supabase:migrate:local": "supabase migration up --local",
    "supabase:restart": "supabase stop && supabase start",
    "supabase:setup": "sh -c 'pnpm supabase:connect \"$@\" && (supabase status >/dev/null 2>&1 || supabase start || (supabase stop && supabase start)) && pnpm supabase:migrate' --",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:studio": "open http://127.0.0.1:54323",
    "supabase:typegen": "supabase gen types --linked --lang typescript --schema public  > /tmp/devhub-database.types.ts",
    "test": "vitest run --project unit --project pglite",
    "test:agent-authoring": "node --test .agents/skills/create-plan/scripts/mark-task.test.mjs .agents/skills/create-subagent/scripts/scaffold-agent.test.mjs",
    "test:changed": "vitest run --project unit --project pglite --changed",
    "test:coverage": "vitest run --project unit --project pglite --coverage",
    "test:db": "vitest run --project pglite",
    "test:e2e": "pnpm test:e2e:studio",
    "test:e2e:fitness": "pnpm --filter my-fitness-app test:e2e",
    "test:e2e:report": "pnpm --filter my-dev-studio exec playwright show-report",
    "test:e2e:studio": "pnpm --filter my-dev-studio test:e2e",
    "test:fitness": "pnpm --filter my-fitness-app test",
    "test:studio": "vitest run --project unit --project pglite",
    "test:tools": "vitest run --project unit tools",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "ui:add": "pnpm dlx shadcn@4.23.0 add --cwd packages/ui",
    "update:dependencies": "pnpm up --recursive",
    "verify": "pnpm check:unused:all && pnpm check:architecture && pnpm check:depcheck:workspaces && pnpm check:security && pnpm check:secrets && pnpm check:ui-catalog && pnpm check:docs && pnpm check:format && pnpm check:circular && pnpm check:ci && pnpm check:fix && pnpm check:outdated && pnpm check:skills && pnpm check:unused:namespaces"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@shared/assistant": "workspace:*",
    "@shared/config": "workspace:*",
    "@shared/lib": "workspace:*",
    "@storybook/addon-vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "depcheck": "catalog:",
    "dependency-cruiser": "catalog:",
    "glob": "catalog:",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "jscpd": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-cli2-formatter-pretty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
