{
  "name": "devhub-showcase",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm db:generate && turbo run build",
    "start": "pnpm --filter web start",
    "clean": "turbo run clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "assist": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "assist:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "typecheck": "pnpm db:generate && tsc --noEmit && turbo run typecheck",
    "types:check": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "create-package": "turbo gen create-package",
    "create-component": "turbo gen create-component"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@prisma/client": "6.19.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@turbo/gen": "2.11.10",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "prisma": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  }
}
