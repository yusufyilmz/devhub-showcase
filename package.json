{
  "name": "devhub-showcase",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "assist": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "build": "turbo run build",
    "build:fitness": "turbo run build --filter=my-fitness-app",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:studio": "turbo run build --filter=my-dev-studio",
    "build:tools": "turbo run build --filter='./tools/*'",
    "check": "pnpm check:links --no-external && pnpm check:catalogs && pnpm check:exports && pnpm check:lint && pnpm check:complexity && pnpm check:docs && pnpm check:skills && pnpm check:exports && pnpm check:types",
    "check:assist": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check:catalogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-catalogs.mjs --check",
    "check:ci": "biome ci --error-on-warnings .",
    "check:complexity": "pnpm exec biome check --only=complexity/noExcessiveCognitiveComplexity --error-on-warnings",
    "check:dependencies": "pnpm exec depcheck",
    "check:docs": "biome format **/*.md && markdownlint-cli2 **/*.md",
    "check:exports": "node tools/cli/scripts/check-exports.mjs",
    "check:fix": "biome check --write .",
    "check:format": "biome format .",
    "check:links": "node tools/cli/links/cli.ts",
    "check:lint": "biome check .",
    "check:skills": "node tools/cli/skills/cli.ts validate",
    "check:types": "pnpm run typecheck",
    "check:ui-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-ui-catalog.mjs --check",
    "check:unused": "pnpm knip --max-show-issues 5",
    "clean": "turbo run clean",
    "cli:check": "node tools/cli/checks/cli.ts",
    "cli:lookup": "node tools/cli/lookup/cli.ts",
    "cli:skills": "node tools/cli/skills/cli.ts",
    "cli:storybook": "node tools/cli/storybook/cli.ts",
    "create-component": "turbo gen create-component --config tools/cli/generators/config.ts",
    "create-package": "turbo gen create-package --config tools/cli/generators/config.ts",
    "cv:generate": "turbo gen cv --config tools/cli/generators/config.ts",
    "dev": "turbo run dev",
    "dev:setup": "node tools/cli/scripts/setup-development.mjs",
    "fix:docs": "pnpm exec markdownlint-cli2 --fix **/*.md && biome format --write **/*.md",
    "fix:skills": "node tools/cli/skills/cli.ts validate --fix",
    "format": "biome format --write .",
    "format:docs": "biome format --write **/*.md",
    "generate:catalogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-catalogs.mjs",
    "generate:ui-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/cli/scripts/generate-ui-catalog.mjs",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:fix:errors": "biome check --diagnostic-level=error --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "lookup": "node tools/cli/lookup/cli.ts",
    "prepare": "husky",
    "run:migration": "supabase migration up --local",
    "start": "pnpm --filter web start",
    "storybook": "pnpm --filter storybook-app storybook",
    "storybook:build": "pnpm --filter storybook-app build-storybook",
    "storybook:start": "pnpm --filter storybook-app start",
    "supabase:connect": "supabase link",
    "supabase:restart": "supabase stop && supabase start",
    "supabase:setup": "sh -c 'pnpm supabase:connect \"$@\" && (supabase status >/dev/null 2>&1 || supabase start || (supabase stop && supabase start)) && pnpm run:migration' --",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:studio": "open http://127.0.0.1:54323",
    "supabase:typegen": "supabase gen types --linked --lang typescript --schema public  > /tmp/devhub-database.types.ts",
    "test": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "pnpm test:e2e:studio",
    "test:e2e:fitness": "pnpm --filter my-fitness-app test:e2e",
    "test:e2e:report": "pnpm --filter my-dev-studio exec playwright show-report",
    "test:e2e:studio": "pnpm --filter my-dev-studio test:e2e",
    "test:fitness": "pnpm --filter my-fitness-app test",
    "test:studio": "vitest run --project unit",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit && turbo run typecheck"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@shared/assistant": "workspace:*",
    "@shared/cli": "workspace:*",
    "@shared/config": "workspace:*",
    "@shared/lib": "workspace:*",
    "@shared/test": "workspace:*",
    "@storybook/addon-vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tsdown/css": "^0.23.5",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "commander": "^15.0.0",
    "depcheck": "^1.4.7",
    "glob": "^14.0.6",
    "husky": "catalog:",
    "js-tiktoken": "catalog:",
    "js-yaml": "^5.5.0",
    "jscpd": "^5.4.2",
    "jsdom": "catalog:",
    "knip": "^6.44.1",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unified": "^11.0.5",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  }
}
