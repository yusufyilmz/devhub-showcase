{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "extends": "//",
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@shared/cli", "@shared/cli/**"],
                "message": "Use relative imports within @shared/cli instead of the package alias."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "off",
        "noUndeclaredEnvVars": "off"
      }
    }
  }
}
