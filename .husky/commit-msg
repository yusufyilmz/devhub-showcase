#!/usr/bin/env sh

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

case "$first_line" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *)
  exit 0
  ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-zA-Z0-9._/-]+\))?(!)?: .+'; then
  echo "husky - commit-msg: use Conventional Commits (e.g. 'feat: add portfolio share link')" >&2
  exit 1
fi
