{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "supabase"],
  "ignoreFiles": ["packages/trello/**", "packages/utils/**", "**/.storybook/**", "**/scripts/**"],
  "rules": {
    "binaries": "warn",
    "cycles": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "error",
    "exports": "error",
    "files": "error",
    "nsExports": "warn",
    "nsTypes": "warn",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error"
  },
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {},
    "apps/*": {
      "includeEntryExports": true
    },
    "packages/*": {
      "includeEntryExports": true
    },
    "packages/utils": {
      "ignoreDependencies": [
        "pino-pretty",
        "remark",
        "remark-gfm",
        "remark-html",
        "remark-math",
        "remark-parse"
      ],
      "includeEntryExports": true
    },
    "tools/*": {
      "includeEntryExports": true
    },
    "tools/cli": {
      "entry": ["checks/secrets.ts", "catalog/ui-registry.d.mts"],
      "includeEntryExports": true
    }
  }
}
