{
  "name": "@shared/services",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./studio": "./src/studio/index.ts",
    "./profile": "./src/profile/index.ts",
    "./portfolio": "./src/portfolio/index.ts",
    "./published-profile": "./src/profile/service/published-profile.ts",
    "./user-profile": "./src/profile/service/user-profile.ts",
    "./db/*": "./src/fitness/db/*",
    "./fitness": "./src/fitness/index.ts",
    "./workspace": "./src/workspace/index.ts",
    "./schedule": "./src/schedule/index.ts",
    "./meal": "./src/meal/index.ts",
    "./types": "./src/types/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm typecheck"
  },
  "dependencies": {
    "@shared/config": "workspace:*",
    "@shared/lib": "workspace:*",
    "@shared/utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
