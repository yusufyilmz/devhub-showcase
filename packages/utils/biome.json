{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@shared/utils", "@shared/utils/**"],
                "message": "Use relative imports within @shared/utils instead of the package alias."
              }
            ]
          }
        }
      }
    }
  }
}
