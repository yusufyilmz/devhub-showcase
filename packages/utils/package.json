{
  "name": "@shared/utils",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./monitoring": {
      "import": "./src/monitoring.ts",
      "require": "./src/monitoring.ts"
    },
    "./logger": {
      "import": "./src/logger/index.ts",
      "require": "./src/logger/index.ts"
    },
    "./client-logger": {
      "import": "./src/logger/client.ts",
      "require": "./src/logger/client.ts"
    },
    "./cli-logger": {
      "import": "./src/logger/cli.ts",
      "require": "./src/logger/cli.ts"
    },
    "./i18n": {
      "import": "./src/i18n/index.ts",
      "require": "./src/i18n/index.ts"
    }
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm typecheck"
  },
  "dependencies": {
    "beautify-console-log": "^1.3.17",
    "flat": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "short-uuid": "catalog:"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
