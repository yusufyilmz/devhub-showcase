{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@fixtures/*": ["../../tools/test/fixtures/*"]
    },
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist"],
  "extends": "@shared/typescript-config/library.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.stories.tsx"]
}
