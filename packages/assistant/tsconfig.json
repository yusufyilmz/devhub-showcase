{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@/env": ["../../apps/my-dev-studio/env.ts"],
      "@/services/*": ["../../apps/my-dev-studio/services/*"],
      "@/views/*": ["../../apps/my-dev-studio/views/*"],
      "@fixtures/*": ["../../tools/test/fixtures/*"]
    },
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist"],
  "extends": "@shared/typescript-config/library.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.stories.tsx"]
}
