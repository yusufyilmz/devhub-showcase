{
  "name": "@shared/assistant",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./models/*": "./src/models/*",
    "./services/*": "./src/services/*",
    "./chat-section": "./src/chat-section/index.ts",
    "./chat": "./src/chat/index.ts",
    "./studio": "./src/studio/index.ts"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm typecheck"
  },
  "dependencies": {
    "@shared/billing": "workspace:*",
    "@shared/cache": "workspace:*",
    "@shared/config": "workspace:*",
    "@shared/lib": "workspace:*",
    "@shared/runtime": "workspace:*",
    "@shared/services": "workspace:*",
    "@shared/ui": "workspace:*",
    "@shared/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "compromise": "catalog:",
    "lucide-react": "catalog:",
    "openai": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
