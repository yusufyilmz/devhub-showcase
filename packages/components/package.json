{
  "name": "@shared/components",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./portfolio": "./src/portfolio/index.ts",
    "./portfolio-chat": "./src/portfolio/chat/index.ts",
    "./sections": "./src/sections/variants/index.ts",
