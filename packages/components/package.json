    "./login": "./src/auth/login-panel.tsx",
    "./studio": "./src/studio/index.ts",
    "./studio/examples.css": "./src/studio/examples/examples.css"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "biome format --write .",
