{
  "name": "@shared/lib",
  "version": "0.0.0",
  "main": "src/index.ts",
  "exports": {
    "./utils": "./src/utils/index.ts",
    "./services": "./src/services/index.ts",
    "./types": "./src/types/index.ts",
    "./errors": "./src/errors/index.ts",
    "./constants": "./src/constants/index.ts",
    "./logger": "./src/log/index.ts",
    "./supabase": "./src/supabase/index.ts",
    "./portfolio": "./src/services/portfolio/index.ts",
    "./profile": "./src/domain/profile.ts",
    "./profile-repository": "./src/repositories/supabase-profile-repository.ts",
    "./profile-service": "./src/services/profile-service.ts",
    "./profile-errors": "./src/repositories/profile-repository.ts",
    "./published-profile": "./src/services/published-profile.ts",
    "./user-profile": "./src/services/user-profile.ts",
    "./username": "./src/domain/username.ts",
    "./section": "./src/domain/section.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@shared/cache": "workspace:*",
    "@shared/content": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "axios": "catalog:",
    "next": "catalog:",
    "zod": "catalog:",
    "pino": "catalog:",
    "@shared/auth": "workspace:*"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
