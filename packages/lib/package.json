{
  "name": "@shared/lib",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types/index.ts",
    "./errors": "./src/errors/index.ts",
    "./supabase": "./src/supabase/index.ts",
    "./profiles": "./src/profiles/index.ts",
    "./section": "./src/domain/section.ts",
    "./section-templates": "./src/domain/section-templates.ts",
    "./pageforge-import": "./src/domain/pageforge-import.ts",
    "./cv-import": "./src/domain/cv-import.ts",
    "./cv-file": "./src/domain/cv-file.ts",
    "./cache": "./src/cache/index.ts",
    "./date": "./src/date/index.ts"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm typecheck"
  },
  "dependencies": {
    "@shared/auth": "workspace:*",
    "@shared/config": "workspace:*",
    "@shared/utils": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "axios": "catalog:",
    "next": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shared/cli": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
