{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "outputs": [],
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "REDIS_URL",
        "REDIS_TOKEN",
        "APPLICATION_NAME",
        "LOG_LEVEL",
        "OPENAI_CV_MODEL",
        "CV_IMPORT_DAILY_LIMIT"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "REDIS_URL",
        "REDIS_TOKEN",
        "APPLICATION_NAME",
        "LOG_LEVEL",
        "OPENAI_CV_MODEL",
        "CV_IMPORT_DAILY_LIMIT"
      ]
    }
  }
}
