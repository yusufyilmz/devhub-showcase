{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CRON_SECRET"],
  "globalPassThroughEnv": ["MONITORING_WEBHOOK_URL", "MONITORING_WEBHOOK_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "GOOGLE_PROFILE_CLIENT_ID"
      ],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "REDIS_URL",
        "REDIS_TOKEN",
        "APPLICATION_NAME",
        "LOG_LEVEL",
        "OPENAI_CV_MODEL",
        "CV_IMPORT_DAILY_LIMIT",
        "OPENAI_CHAT_MODEL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRO_PRICE_ID",
        "STRIPE_PRO_CHAT_LIMIT",
        "STRIPE_PRO_EDITOR_LIMIT",
        "SUPABASE_SERVICE_ROLE_KEY",
        "OPENAI_EDITOR_MODEL"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "my-dev-studio#build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "GOOGLE_PROFILE_CLIENT_ID"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "REDIS_URL",
        "REDIS_TOKEN",
        "APPLICATION_NAME",
        "LOG_LEVEL",
        "OPENAI_CV_MODEL",
        "CV_IMPORT_DAILY_LIMIT",
        "OPENAI_CHAT_MODEL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRO_PRICE_ID",
        "STRIPE_PRO_CHAT_LIMIT",
        "STRIPE_PRO_EDITOR_LIMIT",
        "SUPABASE_SERVICE_ROLE_KEY",
        "OPENAI_EDITOR_MODEL"
      ]
    },
    "my-fitness-app#build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "APP_URL",
        "WORKSPACE_OWNER_ID"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": ["SUPABASE_DB_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "storybook-app#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
